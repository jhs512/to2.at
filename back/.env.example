# Copy to back/.env (gitignored) and fill in. Nothing here belongs in a
# tracked file — see ADR 0005.

# Kakao developer console > 앱 키 > REST API 키. This is the OAuth client_id and
# travels in the browser's address bar during login, so it is not high-value.
KAKAO_CLIENT_ID=
# Kakao developer console > 카카오 로그인 > 보안 > Client Secret. This one IS a
# secret. It is enabled by default on newly issued keys, and token exchange
# fails with an opaque 401 if it is enabled and not sent.
KAKAO_CLIENT_SECRET=

# The Operator's password. Set it to run the console locally.
ADMIN_PASSWORD=
